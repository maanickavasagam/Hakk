# Copy to backend/.env and fill in. .env is git-ignored; this file is not.
# Every value here is optional — Hakk runs with none of them set, using the
# keyword classifier, the template drafter, and console OTP delivery.

# ---- LLM -------------------------------------------------------------------
# Tried in order: Anthropic, then Groq, then the no-key template fallback.
# GET /api/config reports which one is actually live, as `llm_provider`.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5
DRAFTER_MODEL=claude-opus-5

GROQ_API_KEY=
GROQ_CLASSIFIER_MODEL=llama-3.3-70b-versatile
GROQ_DRAFTER_MODEL=llama-3.3-70b-versatile

# ---- Email OTP -------------------------------------------------------------
# Leave SMTP_HOST blank to print codes to the console and accept any 6 digits.
# With it set, the emailed code is required, expires in 10 minutes, is single
# use, and is burned after 5 wrong attempts.
# For Gmail this must be an App Password, not the account password; spaces are
# stripped automatically, so pasting the four displayed groups is fine.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Hakk
SMTP_TIMEOUT_SECONDS=12

# ---- Demo clock ------------------------------------------------------------
# 1 statutory day = this many real seconds. 86400 (or DEMO_MODE=false) is real
# time. Changeable at runtime from the footer badge or POST /api/config/clock.
DEMO_MODE=true
DEMO_SECONDS_PER_DAY=2.0
SCHEDULER_INTERVAL_SECONDS=5

# ---- App -------------------------------------------------------------------
JWT_SECRET=change-me-in-anything-that-is-not-a-demo
JWT_EXPIRY_HOURS=72
CONFIDENCE_THRESHOLD=0.55
CONTACT_EMAIL=help@hakk.legal
CONTACT_PHONE=+91 80 4718 2200
